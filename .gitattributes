# Normalise to LF in the repo. Without this, a Windows checkout with core.autocrlf=true rewrites
# gradlew to CRLF and every POSIX shell answers "bad interpreter: no such file or directory".
* text=auto eol=lf

gradlew      text eol=lf
*.sh         text eol=lf
*.bat        text eol=crlf
gradlew.bat  text eol=crlf

*.png binary
*.jar binary
